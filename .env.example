# ── Application ───────────────────────────────────────────────
APP_NAME="MoCRA Compliance Platform API"
ENVIRONMENT=development          # development | staging | production
DEBUG=true
API_V1_PREFIX=/api/v1
SECRET_KEY=change-me-in-production-use-a-long-random-string

# ── Database (PostgreSQL) ─────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=certi
POSTGRES_PASSWORD=certi
POSTGRES_DB=certi
# Optional full override; if unset it is built from the parts above
# DATABASE_URL=postgresql+asyncpg://certi:certi@localhost:5432/certi

# ── Redis (cache / queue) ─────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Auth ──────────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# ── CORS ──────────────────────────────────────────────────────
# Comma-separated or JSON array of explicitly allowed origins.
BACKEND_CORS_ORIGINS=http://localhost:3000
# Regex for allowed origins (defaults to any *.vercel.app). Override to lock down.
# BACKEND_CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# ── FDA ESG NextGen API (placeholder — fill after test account) ─
ESG_BASE_URL=
ESG_API_KEY=
ESG_ENV=test                     # test | production
